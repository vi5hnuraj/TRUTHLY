{
  "name": "truthly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:herald && npm run test:scout && npm run test:evidence && npm run test:economy && npm run test:intel && npm run test:settle && npm run test:flash && npm run test:world && npm run test:council && npm run test:uniswap && npm run test:market && npm run test:mcp",
    "test:e2e": "npx tsx scripts/e2e-test.ts",
    "test:herald": "tsx --test src/lib/herald/*.test.ts",
    "test:scout": "tsx --test src/lib/collectors/*.test.ts src/lib/dedupe.test.ts",
    "test:evidence": "tsx --test src/lib/evidence.test.ts src/lib/signal-filing.test.ts",
    "test:economy": "tsx --test src/lib/payout-allocation.test.ts",
    "test:intel": "tsx --test src/lib/intel.test.ts",
    "test:settle": "tsx --test src/lib/settle.test.ts",
    "test:flash": "tsx --test src/lib/flash/*.test.ts",
    "test:world": "tsx --test src/lib/world/*.test.ts",
    "test:mcp": "npm --prefix mcp test",
    "test:council": "tsx --test src/lib/council/*.test.ts",
    "test:uniswap": "tsx --test src/lib/uniswap/*.test.ts",
    "test:market": "tsx --test src/lib/market/*.test.ts",
    "verify:flash": "tsx scripts/verify-flash.ts",
    "verify:market": "tsx scripts/verify-market-integrity.ts",
    "verify": "npm run lint && npm test && npm run build",
    "preflight:deploy": "tsx scripts/preflight-deploy.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-query": "^5.105.0",
    "@worldcoin/idkit": "^4.6.0",
    "@worldcoin/idkit-core": "^4.6.0",
    "@x402/core": "^2.29.0",
    "@x402/evm": "^2.29.0",
    "@x402/fetch": "^2.29.0",
    "@x402/next": "^2.29.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^0.7.0",
    "jose": "^6.2.13",
    "lightweight-charts": "^5.2.1",
    "next": "^16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0",
    "tldts": "^7.4.19",
    "uuid": "^13.0.0",
    "viem": "^2.47.6",
    "wagmi": "^3.7.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "zod": "$zod"
  }
}
