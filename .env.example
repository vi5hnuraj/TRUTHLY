# Required
EDITOR_API_KEY=change-me-to-a-secret   # Secret key for editor agent endpoints

# Turso Database (required)
TURSO_DATABASE_URL=                     # libsql://your-db.turso.io
TURSO_AUTH_TOKEN=                       # turso db tokens create <db-name>

# x402 (required for paid editions)
TREASURY_ADDRESS=                       # Platform treasury address (EVM)
X402_FACILITATOR_URL=https://facilitator.payai.network  # x402 facilitator (Base mainnet)
X402_NETWORK=eip155:8453                # Base mainnet (eip155:84532 for Base Sepolia)
CRON_SECRET=                            # Vercel cron auth for Herald's daily run

# Scout discovery queue (comma/newline separated; collection never pays or files)
SCOUT_RSS_FEEDS=https://blog.ethereum.org/feed.xml
SCOUT_GITHUB_REPOS=ethereum/go-ethereum,bitcoin/bitcoin
GITHUB_TOKEN=                           # Optional; raises GitHub API rate limits
SCOUT_SNAPSHOT_SPACES=ens.eth,uniswapgovernance.eth,aave.eth
SNAPSHOT_API_KEY=                       # Optional; raises Snapshot's API rate limit

# Evidence ownership and primary-source scoring (JSON domain -> owner, comma-separated domains)
SOURCE_OWNERSHIP_MAP={}
PRIMARY_SOURCE_DOMAINS=

# Optional
RESEND_API_KEY=                         # For email delivery (free tier: 100/day)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
TRUTHLY_URL=http://localhost:3000       # Internal/public base used by remote MCP tool calls

# Herald (AI fact-checking editor; pays for its own inference via x402 from the treasury wallet)
TREASURY_PRIVATE_KEY=                   # Signs Herald calls, reporter payouts and real stake refunds. Never commit.
HERALD_MODEL=google/gemini-3.1-flash-lite-preview  # ~$0.001 per check via glim.sh x402
HERALD_MAX_ATOMIC=30000                 # Max USDC atomic units Herald pays per inference call (30000 = $0.03)

# World ID Agent Pass (fresh consequential-action authorization) — auth.world.org/portal
WORLDID_ISSUER=https://sandbox.auth.world.org
WORLDID_CLIENT_ID=
WORLDID_CLIENT_SECRET=
WORLDID_AUTH_METHOD=client_secret_basic
WORLDID_ACR=https://world.org/oidc/acr/orb  # current discovery-supported Orb assurance class

# IDKit proof of unique human (one durable newsroom principal)
IDKIT_APP_ID=
IDKIT_RP_ID=
IDKIT_SIGNING_KEY=
IDKIT_ACTION=truthly-human-principal
IDKIT_ENVIRONMENT=staging
IDKIT_VERIFY_URL=https://developer.world.org/api/v4/verify
IDKIT_STAGING_TOKEN=
IDKIT_ALLOW_SIMULATOR=0                   # Dev only; never enable simulator proofs in production

# ENSv2 bylines — real RPC for on-chain verification (mainnet: continuity lane)
OPENCHAIN_MAINNET_RPC=
OPENCHAIN_SEPOLIA_RPC=

# Flash trade desk — the "agent trades on the verified signal" step
# FLASH_API_KEY: your own key from flash.definitive.fi (their public dev key works without it)
# FLASH_FUNDER_PRIVATE_KEY: burner wallet holding a few USDC on Base — ARMS real execution
# FLASH_RPC_URL: optional. Every order still requires an explicit API/MCP approval.
# FLASH_MAX_TRADE_USD: hard per-order cap (default 5)
# FLASH_TOKEN_ADDRESSES: JSON symbol -> Base token contract; ETH/WETH are built in
# FLASH_TOKEN_DECIMALS: JSON symbol -> exact ERC-20 decimals for every custom token
FLASH_API_KEY=
FLASH_FUNDER_PRIVATE_KEY=
FLASH_RPC_URL=
FLASH_MAX_TRADE_USD=5
FLASH_TOKEN_ADDRESSES={}
FLASH_TOKEN_DECIMALS={}

# Uniswap market-integrity guard — official Trading API, server-side only.
# Live Definitive execution fails closed unless a fresh Base V2/V3/V4 quote is
# within UNISWAP_MAX_DEVIATION_BPS of the same-notional Definitive market read.
UNISWAP_API_KEY=                       # developers.uniswap.org/dashboard; never expose to the browser
UNISWAP_MAX_DEVIATION_BPS=100          # 100 bps = 1%; valid production range 1..2000
UNISWAP_QUOTE_MAX_AGE_MS=30000         # official guidance: refresh quotes older than 30 seconds
UNISWAP_TRIAL_NOTIONAL_USDC=5           # read-only sponsor rehearsal; matches the live demo cap

# Trading Intelligence Council + explicit paper-only Demo Mode
TRUTHLY_DEMO_MODE=0                    # Set to 1 only on an intentionally labelled demo deployment
COUNCIL_GROQ_API_KEY=                     # Server-only; no mock recommendation is generated when absent
COUNCIL_GROQ_MODEL=openai/gpt-oss-120b
LIVE_COUNCIL_AUTO_RUN=1                    # After publish/refund, analyze each eligible live ETH story once
LIVE_COUNCIL_CRON_LIMIT=3                  # Maximum missing live decisions generated per editor cron run
LIVE_COUNCIL_NOTIONAL_USDC=5               # Same-notional Definitive/Uniswap market snapshot used by the agents
DEMO_QUOTE_FUNDER_ADDRESS=                # Optional public address used only for read-only Definitive quotes
DEMO_PAPER_NOTIONAL_USDC=100              # Hypothetical amount; never submitted
